# ---------------------------------------------------------------
# Variables de producción de CherryCore.
#   cp .env.prod.example .env && chmod 600 .env
# NUNCA subir .env a git. Valores de ejemplo: cámbialos TODOS.
# ---------------------------------------------------------------

# --- Dominios (registros DNS A/AAAA apuntando a la VM) ----------
# Login, API y frontal. Es el "issuer" de los tokens: no cambiarlo después.
APP_DOMAIN=auth.example.com
# Logos públicos de las empresas (RustFS, solo lectura).
MEDIA_DOMAIN=media.example.com
# Email para Let's Encrypt (avisos de caducidad de certificados).
ACME_EMAIL=ops@example.com

# --- Versión de las imágenes (etiqueta local) -------------------
CHERRYCORE_VERSION=latest
# Ruta al repo del frontal, relativa a deploy/ (o absoluta).
FRONTEND_SRC=../../cherry-core-front
# Memoria máxima del backend (la JVM usa el 75 %).
BACKEND_MEMORY_LIMIT=1g

# --- PostgreSQL --------------------------------------------------
DB_NAME=cherry_core
DB_USERNAME=cherrycore
# openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=cambia-esto

# --- Almacenamiento (RustFS, compatible S3) ----------------------
STORAGE_ACCESS_KEY=cherrycore
# openssl rand -base64 32 | tr -d '/+='
STORAGE_SECRET_KEY=cambia-esto
STORAGE_BUCKET=cherrycore-media

# --- Seguridad ---------------------------------------------------
# Cifra los secretos MFA. openssl rand -base64 32. Que no se pierda nunca
# (sin ella nadie podrá validar su MFA). Rotarla: docs/despliegue.md §11.
CHERRYCORE_ENCRYPTION_KEY=cambia-esto
# Id de la clave actual (va delante de cada secreto cifrado). Cambiarlo al rotar.
CHERRYCORE_ENCRYPTION_KEY_ID=1
# Solo durante una rotación: la clave ANTERIOR (ver docs/despliegue.md §11).
CHERRYCORE_PREVIOUS_ENCRYPTION_KEY=
# Clave HMAC de los códigos de recuperación MFA. openssl rand -base64 32.
# Si se cambia, los códigos de recuperación existentes dejan de valer.
CHERRYCORE_HASH_KEY=cambia-esto
# Identificador de la clave de firma JWT (deploy/secrets/jwt-*.pem).
# Cambiarlo al rotar la clave (docs/despliegue.md §11): la anterior se sigue
# publicando unos días desde ./config/application-prod.yaml.
JWT_KEY_ID=cherrycore-2026-11

# --- Email (Brevo por SMTP) -------------------------------------
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Brevo → SMTP & API → SMTP: "Login" y una "SMTP key" (no la contraseña de la cuenta).
MAIL_USERNAME=cambia-esto@smtp-brevo.com
MAIL_PASSWORD=cambia-esto
# Remitente con el dominio verificado en Brevo (SPF/DKIM).
MAIL_FROM=no-reply@example.com

# --- Primer superadmin -----------------------------------------
# Solo actúa si aún no hay ningún superadmin. Vaciar tras el primer arranque.
SUPER_ADMIN_EMAIL=admin@example.com

# --- Login social (opcional) -----------------------------------
# Solo se usan si existe deploy/config/application-prod.yaml que los
# referencie (ver docs/arranque.md). Sin ese fichero no aparece el botón.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# --- Copias de seguridad (scripts/backup-postgres.sh) ------------
BACKUP_DIR=/var/backups/cherrycore
BACKUP_RETENTION_DAYS=14
